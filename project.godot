[layer_names]

3d_render/layer_10="Player"
3d_render/layer_20="EditorOnly"
3d_physics/layer_2="Pickups"
3d_physics/layer_4="collidables"
3d_physics/layer_5="Interactables"
3d_physics/layer_8="Player"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2
3d/merge_rasterizer_cell_scale=0.2
3d/use_edge_connections=false
3d/default_edge_connection_margin=0.05
3d/default_link_connection_radius=0.05

[physics]

3d/sleep_threshold_linear=0.5
3d/time_before_sleep=1.0

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
