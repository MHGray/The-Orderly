; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameLikeJam"
run/main_scene="uid://cswtphud07syg"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/3d_panning_strength=1.0

[autoload]

Maestro="*res://audio/maestro.tscn"
Global="*res://globals.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/raytraced_audio/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[global_group]

item_container=""
navable=""
pre_orderly=""
pre_hammer=""
pre_church=""
pre_keypad=""
pre_screwdriver=""
dumbwaiter=""

[importer_defaults]

wavefront_obj={
&"generate_lightmap_uv2": true
}
scene={
&"meshes/light_baking": 2
}

